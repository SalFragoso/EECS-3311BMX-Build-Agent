-weightGrams: double
-styleTags: Set&lt;RidingStyle&gt;
--
+spec(key): String</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>300</x><y>350</y><w>240</w><h>150</h></coordinates><panel_attributes>Assembly
