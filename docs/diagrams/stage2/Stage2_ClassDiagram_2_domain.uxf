<element><id>UMLClass</id><coordinates><x>180</x><y>30</y><w>210</w><h>200</h></coordinates><panel_attributes>/BikeComponent/
--
--
+getName(): String
+getPrice(): Money
+getWeight(): double
+getParts(): List&lt;Part&gt;</panel_attributes><additional_attributes></additional_attributes></element>
<element><id>UMLClass</id><coordinates><x>30</x><y>290</y><w>200</w><h>270</h></coordinates><panel_attributes>Part
--
-id: Long
-brand: String
-model: String
-category: PartCategory
-specs: Map&lt;String,String&gt;
