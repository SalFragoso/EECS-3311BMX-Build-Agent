# Copy this file to .env (same folder) and fill in your own values.
# .env is gitignored, so your real secrets never get committed.

# Local Postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_LOCAL_PASSWORD_HERE

# Groq API key for the AI agent: https://console.groq.com -> API Keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
